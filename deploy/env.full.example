# Every variable, generated by tools/config_reference.py (do not edit by hand).
# Copy to deploy/.env (or paste into the hosting panel) and replace every mock value.
# Local run: docker compose --env-file deploy/.env -f compose.yaml \
#   -f deploy/compose.local.yaml up -d
# Values under a '[mock: replace]' line are fake; the others are the defaults (delete a
# default line to follow future defaults). No inline comments (panels keep them).

# ---- docker compose ----
# [mock: replace] Database owner (runs migrations only).
DB_OWNER_PASSWORD=mock-owner-Zq7v3XkP9sWm2LtR8yHc4NbD
# [mock: replace] Role the API and workers use (no superuser, no BYPASSRLS).
DB_APP_PASSWORD=mock-app-Hn5cR1tYw8QeLp3VbJ6sKd2M
# Image tag to run (a registry tag when not building on the host).
MINDGRID_IMAGE=mindgrid:local
# Host port on 127.0.0.1 (deploy/compose.local.yaml only).
MINDGRID_HTTP_PORT=8700

# ---- ConnectorSettings (mindgrid.bridges.connectors.config) ----
# Shortest schedule interval.
MINDGRID_CONNECTOR_MIN_EVERY_MINUTES=5

# ---- BrandSettings (mindgrid.core.brand) ----
# Displayed product name.
MINDGRID_BRAND_NAME=MindGrid
# [mock: replace] Short name (narrow headers); blank = the name.
MINDGRID_BRAND_SHORT_NAME=MG
# [mock: replace] Optional line under the name.
MINDGRID_BRAND_TAGLINE=Knowledge, playbooks and data in one place
# [mock: replace] Logo image URL or path served by the web app.
MINDGRID_BRAND_LOGO_URL=https://mindgrid.example.com/static/logo.svg
# Primary UI colour (#rrggbb).
MINDGRID_BRAND_PRIMARY_COLOR=#4f46e5
# Primary UI colour in the dark theme (#rrggbb; light enough to read on black).
MINDGRID_BRAND_PRIMARY_COLOR_DARK=#60a5fa

# ---- OutboundSettings (mindgrid.core.netguard) ----
# [mock: replace] Hosts outbound calls may reach although they resolve to a private or loopback address (also allowed over plain http), e.g. an internal service.
MINDGRID_OUTBOUND_ALLOW_PRIVATE_HOSTS=zservice.internal

# ---- RuntimeSettings (mindgrid.core.runtime) ----
# Deployment environment.
# MINDGRID_ENV=  (the image sets production)
# Minimum log level.
MINDGRID_LOG_LEVEL=info
# JSON log lines (off = readable console lines).
# MINDGRID_LOG_JSON=  (the image sets true)
# Serve the OpenAPI docs at /docs.
MINDGRID_DOCS=true

# ---- DatasetSettings (mindgrid.datasets.config) ----
# Largest dataset file (raw).
MINDGRID_DATASET_MAX_BYTES=209715200
# Versions kept per dataset (older ones go).
MINDGRID_DATASET_KEEP_VERSIONS=30

# ---- DatabaseSettings (mindgrid.db.config) ----
# App connection (postgresql+asyncpg://…), as the non-owner app role.
# MINDGRID_DATABASE_URL=  (set by compose from DB_APP_PASSWORD)
# Owner connection used only by migrations; blank = MINDGRID_DATABASE_URL.
# MINDGRID_MIGRATION_DATABASE_URL=  (set by compose (migrate service) from DB_OWNER_PASSWORD)
# Name of the app role migrations grant table access to.
MINDGRID_DB_APP_ROLE=mindgrid_app
# Connections per process.
MINDGRID_DB_POOL_SIZE=10
# Server-side limit per statement.
MINDGRID_DB_STATEMENT_TIMEOUT_MS=15000

# ---- BodySettings (mindgrid.interfaces.body_limit) ----
# Largest non-upload request body (bytes).
MINDGRID_MAX_BODY_BYTES=1048576

# ---- WebSettings (mindgrid.interfaces.web) ----
# Built web app folder; blank = API only.
# MINDGRID_WEB_DIST=  (the image sets /app/web/dist)

# ---- EvalSettings (mindgrid.knowledge.evals.config) ----
# Days a question stays in the recall log (0 = do not log questions).
MINDGRID_RECALL_LOG_DAYS=90
# Most cases in one eval run.
MINDGRID_EVAL_MAX_CASES=500
# Longest wait for the judge on one case.
MINDGRID_EVAL_JUDGE_SECONDS=120

# ---- IndexSettings (mindgrid.knowledge.index.config) ----
# Longest wait for one chunk's context line.
MINDGRID_INDEX_CONTEXT_SECONDS=60
# Longest context line kept per chunk.
MINDGRID_INDEX_CONTEXT_MAX_CHARS=400
# Document outline (its headings) given with each chunk.
MINDGRID_INDEX_CONTEXT_OUTLINE_CHARS=2000
# Text before and after the chunk given with it.
MINDGRID_INDEX_CONTEXT_NEIGHBOUR_CHARS=600

# ---- IntakeSettings (mindgrid.knowledge.intake.config) ----
# Largest document upload (bytes).
MINDGRID_MAX_UPLOAD_BYTES=26214400
# Target chunk size in characters (~512 tokens).
MINDGRID_CHUNK_CHARS=2000
# Characters repeated between chunks.
MINDGRID_CHUNK_OVERLAP_CHARS=250
# Pages read from one PDF at most.
MINDGRID_PDF_MAX_PAGES=2000
# CSV rows per chunk (knowledge mode).
MINDGRID_CSV_ROWS_PER_CHUNK=25

# ---- RecallSettings (mindgrid.knowledge.recall.config) ----
# Passages returned by default.
MINDGRID_RECALL_K=8
# Most passages per request.
MINDGRID_RECALL_MAX_K=50
# Candidates each retriever adds before fusion.
MINDGRID_RECALL_CANDIDATES=50
# Reciprocal-rank-fusion constant (higher = flatter).
MINDGRID_RECALL_RRF_K=60
# HNSW search breadth (recall vs. speed).
MINDGRID_RECALL_EF_SEARCH=100
# Minimum word similarity for the trigram retriever (0-1).
MINDGRID_RECALL_TRIGRAM_THRESHOLD=0.3
# Fused passages the reranker re-scores (at least k). Measured on real documents: 10 matched 16 and 20 in quality at a third of the time.
MINDGRID_RECALL_RERANK_CANDIDATES=10
# Reranker probability below which a passage is dropped as unrelated (measured for bge-reranker-v2-m3: relevant >= 0.011, unrelated <= 0.002).
MINDGRID_RECALL_MIN_RELEVANCE=0.005
# Without a reranker: a passage without an exact keyword match is dropped beyond this cosine distance. 0 = the value measured for the embedding model (EmbeddingGemma-300m 0.71, Qwen3-Embedding-0.6B 0.6, others 0.6).
MINDGRID_RECALL_MAX_VECTOR_DISTANCE=0.0
# Longest wait for a query rewrite (setting recall.rewrite); then the original question is searched alone.
MINDGRID_RECALL_REWRITE_SECONDS=20
# Longest accepted query.
MINDGRID_RECALL_MAX_QUERY_CHARS=2000

# ---- KeySettings (mindgrid.platform.apikeys.config) ----
# Access token lifetime (seconds).
MINDGRID_ACCESS_TOKEN_TTL_S=900
# Refresh token lifetime (days).
MINDGRID_REFRESH_TOKEN_TTL_DAYS=30
# Largest allowed clock difference of a signature.
MINDGRID_SIGNATURE_SKEW_S=300
# Longest lifetime of an API key (days).
MINDGRID_KEY_MAX_DAYS=365

# ---- EventSettings (mindgrid.platform.events.config) ----
# [mock: replace] Base URL receivers use to reach this server (links in events, dataschema).
MINDGRID_PUBLIC_URL=https://mindgrid.example.com
# Wait before each retry (Standard Webhooks schedule, about 3 days in total).
MINDGRID_EVENT_RETRY_SECONDS=5,300,1800,7200,18000,36000,50400,72000,86400
# Longest wait for a receiver's answer.
MINDGRID_EVENT_TIMEOUT_SECONDS=15
# Largest event `data` (thin events link out).
MINDGRID_EVENT_MAX_DATA_BYTES=20000
# A subscription is switched off after this many dead deliveries in a row.
MINDGRID_EVENT_DISABLE_AFTER_DEAD=5
# Days events and their deliveries are kept.
MINDGRID_EVENT_KEEP_DAYS=30
# Deliveries claimed per pass.
MINDGRID_EVENT_BATCH=20
# How often the worker looks for due deliveries.
MINDGRID_EVENT_EVERY_SECONDS=2

# ---- SessionSettings (mindgrid.platform.identity.config) ----
# Absolute session lifetime (hours).
MINDGRID_SESSION_TTL_HOURS=12
# Session ends after this long unused (minutes).
MINDGRID_SESSION_IDLE_MINUTES=60
# Least time between last-seen writes (s).
MINDGRID_SESSION_TOUCH_EVERY_S=60

# ---- JobSettings (mindgrid.platform.jobs.config) ----
# A claimed job not finished within this time is given to another worker.
MINDGRID_JOB_LEASE_SECONDS=600
# Tries before a job is marked failed.
MINDGRID_JOB_MAX_ATTEMPTS=5
# First retry delay; doubles each attempt.
MINDGRID_JOB_RETRY_BASE_SECONDS=30
# Worker pause when the queue is empty.
MINDGRID_JOB_IDLE_SECONDS=2.0

# ---- SecuritySettings (mindgrid.platform.security.config) ----
# [mock: replace] Server secret (32+ bytes). Required.
MINDGRID_SECRET_KEY=mock-secret-REPLACE-ME-k3v9Qw2Lp8Zs5Xn1Rt7Yb4Hc6Jd0Fm
# Sign-in attempts per IP + email per window.
MINDGRID_SIGNIN_LIMIT=5
# Sign-in attempts per IP per window.
MINDGRID_SIGNIN_IP_LIMIT=20
# Sign-in rate-limit window (seconds).
MINDGRID_SIGNIN_WINDOW_S=60

# ---- EmbeddingSettings (mindgrid.providers.config) ----
# local (on this machine, no key) | gemini (needs the Gemini key) | hashing (tests)
MINDGRID_EMBEDDING_PROVIDER=local
# fastembed model. Default EmbeddingGemma-300m (multilingual incl. Thai, Gemma terms; measured 6x faster than Qwen/Qwen3-Embedding-0.6B-Q at equal reranked quality; use that one for Apache-2.0).
MINDGRID_EMBED_LOCAL_MODEL=google/embeddinggemma-300m
# Its vector size (0 = the model's known size; must match the model).
MINDGRID_EMBED_LOCAL_DIMS=0
# CPU threads for local embedding.
MINDGRID_EMBED_THREADS=2
# Model download folder (blank = ~/.cache/mindgrid/models).
# MINDGRID_EMBED_CACHE_DIR=  (the image sets /data/models (the models volume))
# [mock: replace] Prompt around a query, with {text} (blank = the model's known format).
MINDGRID_EMBED_QUERY_TEMPLATE=task: search result | query: {text}
# [mock: replace] Prompt around a document chunk, with {text} (blank = the model's known format).
MINDGRID_EMBED_DOCUMENT_TEMPLATE=title: none | text: {text}
# Gemini embedding model.
MINDGRID_EMBED_GEMINI_MODEL=gemini-embedding-2
# Truncated (MRL) size; pgvector indexes <= 2000.
MINDGRID_EMBED_GEMINI_DIMS=1536
# Texts per embedding call.
MINDGRID_EMBED_BATCH=16

# ---- LlmSettings (mindgrid.providers.config) ----
# Gemini model that writes answers.
MINDGRID_LLM_GEMINI_MODEL=gemini-flash-latest
# [mock: replace] Ollama server (local mode).
MINDGRID_LLM_LOCAL_URL=http://host.docker.internal:11434
# [mock: replace] Ollama model.
MINDGRID_LLM_LOCAL_MODEL=gemma3:4b
# Context window asked of the local model (prompt + answer). Ollama's own default (4096) silently cuts a longer prompt; the passages are fitted to this window.
MINDGRID_LLM_LOCAL_CONTEXT_TOKENS=16384
# Longest wait for one answer.
MINDGRID_LLM_TIMEOUT_SECONDS=120
# Low = sticks to the passages.
MINDGRID_LLM_TEMPERATURE=0.1
# Longest answer.
MINDGRID_LLM_MAX_OUTPUT_TOKENS=2048

# ---- RerankSettings (mindgrid.providers.config) ----
# local (cross-encoder on this machine, no key) | none (fused order only)
MINDGRID_RERANK_PROVIDER=local
# fastembed cross-encoder (Apache-2.0, multilingual incl. Thai).
MINDGRID_RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3-int8
# CPU threads for local reranking.
MINDGRID_RERANK_THREADS=2
# Start of each passage given to the reranker. Measured on real documents: 500 matched 700 and 2000 in quality (350 lost hits); cost grows with length.
MINDGRID_RERANK_MAX_CHARS=500

# ---- SynapseSettings (mindgrid.synapse.config) ----
# [mock: replace] Folders a source repository may be in (absolute paths; empty = none allowed).
MINDGRID_SYNAPSE_ALLOWED_ROOTS=/sources
# Largest file read from a source.
MINDGRID_SYNAPSE_MAX_FILE_BYTES=200000
# Most items in one proposal.
MINDGRID_SYNAPSE_MAX_ITEMS=200
# Longest wait for one git command.
MINDGRID_SYNAPSE_GIT_TIMEOUT=30

# ---- CLI / MCP client only (a user's machine, not the server) ----
# Client profiles folder (blank = ~/.config/mindgrid).
# MINDGRID_CONFIG_DIR=
# Token cache folder (blank = ~/.cache/mindgrid).
# MINDGRID_CLIENT_CACHE_DIR=
# Client profile used by the CLI and the MCP server.
# MINDGRID_PROFILE=default
