{
  "name": "mindgrid-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "vite build",
    "gen:i18n": "node scripts/gen-i18n.ts",
    "check-i18n": "node scripts/check-i18n.ts",
    "check-budget": "node scripts/check-budget.ts",
    "gen:api": "openapi-typescript openapi/openapi.json -o src/services/api/openapi.gen.ts",
    "check:api": "openapi-typescript openapi/openapi.json | diff -q - src/services/api/openapi.gen.ts",
    "verify": "npm run check:api && npm run check-i18n && npm run gen:i18n && npm run build && npm run typecheck && npm run lint && npm run test && npm run check-budget"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.29.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.21",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/plugin-message-format": "4.5.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-query-devtools": "5.104.4",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
