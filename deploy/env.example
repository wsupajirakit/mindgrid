# Copy to deploy/.env and fill in. Generate secrets with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Server secret (32+ bytes): sessions, CSRF, sealed secrets and the event signing key are
# derived from it. Changing it signs everyone out, makes stored secrets unreadable (set them
# again) and changes the event public key (receivers fetch /v1/events/keys again).
MINDGRID_SECRET_KEY=
# Public base URL (links in events and callbacks).
MINDGRID_PUBLIC_URL=https://mindgrid.example.com
# Displayed name (one place; blank = the default name).
MINDGRID_BRAND_NAME=
# Optional: allow outbound calls to internal hosts (connectors, webhooks), comma separated.
MINDGRID_OUTBOUND_ALLOW_PRIVATE_HOSTS=
# Optional: folders Synapse may read source repositories from (mounted read-only).
MINDGRID_SYNAPSE_ALLOWED_ROOTS=
